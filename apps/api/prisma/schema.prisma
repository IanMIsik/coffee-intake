generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  ADMIN
  CLERK
}

enum OtpPurpose {
  FARMER_LOGIN
}

model Organization {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  smsSenderName   String
  // Incremented atomically to mint auto-generated receipt numbers (e.g. DF-000123)
  // when a clerk doesn't type one in from a paper book.
  receiptSequence Int      @default(0)
  // IANA time zone used to decide which calendar day a delivery belongs to (dashboard).
  timezone        String   @default("Africa/Nairobi")
  createdAt       DateTime @default(now())

  staffUsers  StaffUser[]
  farmers     Farmer[]
  receipts    Receipt[]
  settlements Settlement[]
  batches     Batch[]
  otpCodes    OtpCode[]
}

model StaffUser {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  name              String
  phone             String
  email             String?
  passwordHash      String
  role              StaffRole
  createdAt         DateTime     @default(now())
  // "Deleting" a staff account sets this instead of removing the row, because
  // receipts they recorded must keep pointing at who recorded them.
  deletedAt         DateTime?
  // Login tokens issued before this moment are rejected, so a password reset also
  // signs the person out of every device that was using the old password.
  passwordChangedAt DateTime?

  receipts          Receipt[]
  settledReceipts   Receipt[]    @relation("SettledReceipts")
  editedReceipts    Receipt[]    @relation("EditedReceipts")
  settlements       Settlement[] @relation("RecordedSettlements")
  voidedSettlements Settlement[] @relation("VoidedSettlements")
  createdBatches    Batch[]

  @@unique([organizationId, phone])
}

model Farmer {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  name               String
  phone              String
  nationalId         String?
  photoUrl           String?
  cumulativeWeightKg Decimal      @default(0) @db.Decimal(12, 2)
  createdAt          DateTime     @default(now())
  // Removed from the farmers list, but never deleted: their deliveries and payments stay on
  // record. Archived farmers can't log in or receive new deliveries.
  archivedAt         DateTime?
  archivedByStaffId  String?

  receipts    Receipt[]
  settlements Settlement[]

  @@unique([organizationId, phone])
}

model Receipt {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  farmerId          String
  farmer            Farmer       @relation(fields: [farmerId], references: [id])
  receiptNumber     String
  weightKg          Decimal      @db.Decimal(10, 2)
  photoUrl          String?
  recordedByStaffId String
  recordedByStaff   StaffUser    @relation(fields: [recordedByStaffId], references: [id])
  clientId          String
  // The day/time the cherry was actually weighed, set by the client at capture time.
  // Distinct from createdAt (when the server persisted it) because the mobile app is
  // offline-first: a receipt recorded Friday evening may not sync until Monday, and
  // must still be tagged to Friday for day-total reporting.
  deliveredAt       DateTime
  createdAt         DateTime     @default(now())
  // Whether the factory has paid the farmer for this batch yet.
  // Agreed price per kg (set by an admin; can be set or changed later).
  pricePerKg        Decimal?     @db.Decimal(10, 2)
  // Kilos paid for so far. Kept equal to the sum of this receipt's settlements so
  // totals can be summed cheaply; settled means every kilo has been paid.
  settledKg         Decimal      @default(0) @db.Decimal(10, 2)
  settled           Boolean      @default(false)
  settledAt         DateTime?
  settledByStaffId  String?
  settledByStaff    StaffUser?   @relation("SettledReceipts", fields: [settledByStaffId], references: [id])
  // Audit trail for clerk/admin corrections to weight or receipt number after entry.
  editedAt          DateTime?
  editedByStaffId   String?
  editedByStaff     StaffUser?   @relation("EditedReceipts", fields: [editedByStaffId], references: [id])

  settlements Settlement[]
  // The batch whose price currently applies to this delivery's unpaid kilos.
  batchId     String?
  batch       Batch?       @relation(fields: [batchId], references: [id])

  @@index([batchId])
  @@unique([organizationId, clientId])
  @@unique([organizationId, receiptNumber])
  @@index([organizationId, farmerId])
  @@index([organizationId, deliveredAt])
  @@index([organizationId, settled])
}

model OtpCode {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  phone          String
  codeHash       String
  purpose        OtpPurpose
  expiresAt      DateTime
  consumedAt     DateTime?
  // Wrong guesses so far; a code stops being accepted after a handful.
  attempts       Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([organizationId, phone])
}

// One payment against (part of) a delivery. A receipt can have several: paying for part of a
// delivery as lots are sold, then the rest later. Voided entries stay for the record but
// no longer count.
model Settlement {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  receiptId         String
  receipt           Receipt      @relation(fields: [receiptId], references: [id])
  farmerId          String
  farmer            Farmer       @relation(fields: [farmerId], references: [id])
  weightKg          Decimal      @db.Decimal(10, 2)
  // Price actually applied to this payment; null when no price was known (e.g. older records).
  pricePerKg        Decimal?     @db.Decimal(10, 2)
  amount            Decimal?     @db.Decimal(12, 2)
  note              String?
  recordedByStaffId String
  recordedByStaff   StaffUser    @relation("RecordedSettlements", fields: [recordedByStaffId], references: [id])
  createdAt         DateTime     @default(now())
  voidedAt          DateTime?
  voidedByStaffId   String?
  voidedByStaff     StaffUser?   @relation("VoidedSettlements", fields: [voidedByStaffId], references: [id])
  // The batch this payment was made under, if any.
  batchId           String?
  batch             Batch?       @relation(fields: [batchId], references: [id])

  @@index([batchId])
  @@index([organizationId, farmerId])
  @@index([receiptId])
}

// A price agreed for a lot of cherry. Publishing one prices every farmer's unpaid kilos at once
// (except farmers who chose to wait, who keep their earlier price and join a later batch).
// Kilos already paid keep the price they were paid at, so a later batch can carry a new
// market price and still cover the unpaid part of a partly-paid delivery.
model Batch {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  name             String
  pricePerKg       Decimal      @db.Decimal(10, 2)
  note             String?
  // Farmers who asked to wait and were left out of this batch.
  heldFarmerIds    String[]
  createdByStaffId String
  createdByStaff   StaffUser    @relation(fields: [createdByStaffId], references: [id])
  createdAt        DateTime     @default(now())

  receipts    Receipt[]
  settlements Settlement[]

  @@index([organizationId, createdAt])
}
