# PostgreSQL connection string
DATABASE_URL="postgresql://coffee:coffee@localhost:5433/coffee_dev"

# Port the API listens on
PORT=4000

# Secret used to sign JWTs -- generate a long random string for real deployments
JWT_SECRET="replace-with-a-long-random-string"

# Shared secret required to call POST /orgs (provisioning a new organization/factory).
# Keep this out of any client app; only whoever is onboarding a new factory should have it.
ORG_PROVISIONING_SECRET="replace-with-a-long-random-string"

# Africa's Talking credentials. Leave blank in development: SMS will be logged to the
# console instead of actually sent.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# Set to true only after your sender ID (each organization's smsSenderName) is
# registered and approved with Africa's Talking; otherwise sends fail.
AFRICASTALKING_USE_SENDER_ID=false

# S3-compatible object storage for receipt/farmer photos. Leave blank in development:
# photos are written to apps/api/uploads and served from /uploads instead.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_PUBLIC_BASE_URL=
