{
  "cli": {
    "requireCommit": false,
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "pnpm": "12.6.0",
      "android": {
        "buildType": "apk"
      }
    },
    "production-apk": {
      "distribution": "internal",
      "pnpm": "12.6.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "production"
      }
    },
    "production": {
      "pnpm": "12.6.0",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_VARIANT": "production"
      }
    }
  }
}
