# Copy to .env.production (never commit it) and fill in every value.

# --- Addresses (DNS records for both must point at this server) ---
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
# The organization code created with `create-org` (see DEPLOY.md)
ORGANIZATION_SLUG=richard-misik-estate

# --- Database (the password is only used inside the Docker network) ---
POSTGRES_USER=coffee
POSTGRES_PASSWORD=generate-a-long-random-password
POSTGRES_DB=coffee

# --- Secrets: random, at least 32 characters. The server refuses to start otherwise. ---
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ORG_PROVISIONING_SECRET=

# --- Africa's Talking (live app username and a freshly generated live API key) ---
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# true only after your sender ID is approved and registered with Africa's Talking
AFRICASTALKING_USE_SENDER_ID=false

# --- Receipt photos: S3 recommended (keep the bucket PRIVATE). Leave blank to use the server's disk. ---
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

LOG_LEVEL=info
